#!/bin/bash

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"

show_help() {
    echo "----------------------------------"
    echo "          Vanguard CLI"
    echo "----------------------------------"
    echo "Usage: vanguard <command>"
    echo
    echo "Commands:"
    echo "  start       Build and start detection system (foreground)"
    echo "  runall      Start the full stack (dashboard, incident board, healing, then detection foreground)"
    echo "  incident    Run incident board"
    echo "  dashboard   Run incident dashboard UI"
    echo "  heal        Run AI self-healing engine"
    echo "  simulate    Run crash simulation suite"
    echo "  watch       Monitor Vanguard resource usage"
    echo "  status      Show running Vanguard processes"
    echo "  reset       Clear incidents.json"
    echo "  stop        Stop all Vanguard components"
    echo "  help        Show this help menu"
    echo
}

case "$1" in

    start)
        cd "$ROOT_DIR/build"
        cmake --build . || { echo "Build failed"; exit 1; }
        sudo "$ROOT_DIR/build/vanguard"
        ;;

    runall)
        mkdir -p "$ROOT_DIR/logs"

        bash "$ROOT_DIR/incident.sh" &
        bash "$ROOT_DIR/dashboard.sh" &
        bash "$ROOT_DIR/selfhealing.sh" &

        cd "$ROOT_DIR/build"
        cmake --build . || { echo "Build failed"; exit 1; }

        sudo "$ROOT_DIR/build/vanguard"
        ;;

    incident)
        bash "$ROOT_DIR/incident.sh"
        ;;

    dashboard)
        bash "$ROOT_DIR/dashboard.sh" &
        ;;

    heal)
        bash "$ROOT_DIR/selfhealing.sh" &
        ;;

    simulate)
        sudo bash "$ROOT_DIR/crash_suite/build.sh"
        sudo bash "$ROOT_DIR/crash_suite/run_all.sh"
        ;;

    watch)
        bash "$ROOT_DIR/watch_vanguard.sh"
        ;;

    reset)
        bash "$ROOT_DIR/reset_incidents.sh"
        ;;

    status)
        ps aux | grep -E "$ROOT_DIR|vanguard|selfhealing|dashboard|incident|crash_test|logparser" | grep -v grep
        ;;

 stop)
    echo "Stopping Vanguard..."

    # Detection binary
    sudo pkill -f "build/vanguard" 2>/dev/null && echo "Stopped vanguard detector."
    

    # Dashboard
    if [[ -f /tmp/vanguard_dashboard.pid ]]; then
        kill -9 "$(cat /tmp/vanguard_dashboard.pid)" 2>/dev/null && rm /tmp/vanguard_dashboard.pid
        echo "Stopped dashboard."
    fi

    # Healing AI
    if [[ -f /tmp/vanguard_heal.pid ]]; then
        kill -9 "$(cat /tmp/vanguard_heal.pid)" 2>/dev/null && rm /tmp/vanguard_heal.pid
        echo "Stopped healing system."
    fi

    # Incident manager
    if [[ -f /tmp/vanguard_incident.pid ]]; then
        kill -9 "$(cat /tmp/vanguard_incident.pid)" 2>/dev/null && rm /tmp/vanguard_incident.pid
        echo "Stopped incident board."
    fi

    # Just in case Python zombies survived
    pgrep -fa "python3.*selfhealing" | awk '{print $1}' | xargs -r kill -9
    pgrep -fa "python3.*dashboard" | awk '{print $1}' | xargs -r kill -9
    pgrep -fa "python3.*incident" | awk '{print $1}' | xargs -r kill -9
    cd "$ROOT_DIR/build"
    sudo docker compose down

    echo "All Vanguard components stopped."
    ;;


    help|--help|-h)
        show_help
        ;;

    *)
        show_help
        exit 1
        ;;

esac

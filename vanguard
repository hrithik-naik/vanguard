#!/bin/bash

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"

show_help() {
    echo "----------------------------------"
    echo "          Vanguard CLI"
    echo "----------------------------------"
    echo "Usage: vanguard <command>"
    echo
    echo "Commands:"
    echo "  start         Build + start detection"
    echo "  runall        Start full stack"
    echo "  incident      Run incident board"
    echo "  dashboard     Run main dashboard UI"
    echo "  aidashboard   Run AI healing dashboard (port 5001)"
    echo "  heal          Run AI healing engine"
    echo "  simulate      Run crash suite"
    echo "  watch         Monitor Vanguard usage"
    echo "  status        List running processes"
    echo "  reset         Clear incidents"
    echo "  stop          Stop all components"
    echo "  help          Show help"
    echo
}

case "$1" in

    start)
        cd "$ROOT_DIR/build"
        cmake --build . || { echo "Build failed"; exit 1; }
        sudo "$ROOT_DIR/build/vanguard"
        ;;

    runall)
        mkdir -p "$ROOT_DIR/logs"

        bash "$ROOT_DIR/incident.sh" &
        bash "$ROOT_DIR/dashboard.sh" &
        bash "$ROOT_DIR/selfhealing.sh" &
        bash "$ROOT_DIR/ai_dashboard.sh" &

        cd "$ROOT_DIR/build"
        cmake --build . || { echo "Build failed"; exit 1; }

        sudo "$ROOT_DIR/build/vanguard"
        ;;

    incident)
        bash "$ROOT_DIR/incident.sh"
        ;;

    dashboard)
        bash "$ROOT_DIR/dashboard.sh" &
        ;;

    aidashboard)  # NEW COMMAND
        echo "Starting AI Action Dashboard (port 5001)..."
        bash "$ROOT_DIR/ai_dashboard.sh" &
        echo $! > /tmp/vanguard_ai_dashboard.pid
        echo "PID saved to /tmp/vanguard_ai_dashboard.pid"
        ;;

    heal)
        bash "$ROOT_DIR/selfhealing.sh" &
        ;;

    simulate)
        sudo bash "$ROOT_DIR/crash_suite/build.sh"
        sudo bash "$ROOT_DIR/crash_suite/run_all.sh"
        ;;

    watch)
        bash "$ROOT_DIR/watch_vanguard.sh"
        ;;

    reset)
        bash "$ROOT_DIR/reset_incidents.sh"
        ;;
    
    status)
        echo "Running Vanguard processes:"
        ps aux | grep -E "$ROOT_DIR|vanguard|ai_dashboard|selfhealing|incident|crash_test|logparser" | grep -v grep
        ;;

    stop)
        echo "Stopping Vanguard..."

        sudo pkill -f "build/vanguard" 2>/dev/null && echo "Stopped detector."

        if [[ -f /tmp/vanguard_dashboard.pid ]]; then
            kill -9 "$(cat /tmp/vanguard_dashboard.pid)" 2>/dev/null && rm /tmp/vanguard_dashboard.pid
            echo "Stopped main dashboard."
        fi

        if [[ -f /tmp/vanguard_ai_dashboard.pid ]]; then
            kill -9 "$(cat /tmp/vanguard_ai_dashboard.pid)" 2>/dev/null && rm /tmp/vanguard_ai_dashboard.pid
            echo "Stopped AI dashboard."
        fi

        if [[ -f /tmp/vanguard_heal.pid ]]; then
            kill -9 "$(cat /tmp/vanguard_heal.pid)" 2>/dev/null && rm /tmp/vanguard_heal.pid
            echo "Stopped healing engine."
        fi

        if [[ -f /tmp/vanguard_incident.pid ]]; then
            kill -9 "$(cat /tmp/vanguard_incident.pid)" 2>/dev/null && rm /tmp/vanguard_incident.pid
            echo "Stopped incident board."
        fi

        pgrep -fa "python3.*ai_dashboard" | awk '{print $1}' | xargs -r kill -9
        pgrep -fa "python3.*selfhealing" | awk '{print $1}' | xargs -r kill -9
        pgrep -fa "python3.*dashboard" | awk '{print $1}' | xargs -r kill -9
        pgrep -fa "python3.*incident" | awk '{print $1}' | xargs -r kill -9

        echo "Stopping Docker (if running)..."
        cd "$ROOT_DIR/build"
        sudo docker compose down

        echo "All Vanguard components stopped."
        ;;

    help|--help|-h)
        show_help
        ;;

    *)
        show_help
        exit 1
        ;;
esac
